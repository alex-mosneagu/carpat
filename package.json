{
  "name": "carpat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='!carpat-docs' run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @carpat/core run build && pnpm -r run typecheck",
    "docs:dev": "pnpm --filter carpat-docs run dev",
    "docs:build": "pnpm --filter carpat-docs run build",
    "docs:preview": "pnpm --filter carpat-docs run preview",
    "carpat": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5",
    "vitest": "^1.0.4"
  },
  "packageManager": "pnpm@8.12.0"
}
