{
  "name": "@carpat/react",
  "version": "0.1.1",
  "type": "module",
  "description": "React components for Romanian form inputs",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "@carpat/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-mosneagu/carpat.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/alex-mosneagu/carpat/issues"
  },
  "homepage": "https://alex-mosneagu.github.io/carpat/",
  "keywords": [
    "romania",
    "react",
    "cnp",
    "forms",
    "validation"
