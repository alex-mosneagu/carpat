    "svelte": "^4.2.8",
    "typescript": "^5.3.3"
  },
  "svelte": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-mosneagu/carpat.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/alex-mosneagu/carpat/issues"
  },
  "homepage": "https://alex-mosneagu.github.io/carpat/",
  "keywords": [
    "romania",
    "svelte",
    "cnp",
    "forms",
    "validation"
  ]
