{
  "name": "@carpat/svelte",
  "version": "0.1.0",
  "type": "module",
  "description": "Svelte components for Romanian form inputs",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "dev": "svelte-package -o dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "dependencies": {
    "@carpat/core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.2.5",
    "svelte": "^4.2.8",
    "typescript": "^5.3.3"
  },
  "svelte": "./dist/index.js"
}
