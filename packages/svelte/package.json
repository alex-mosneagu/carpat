{
  "name": "@carpat/svelte",
  "version": "0.1.1",
  "type": "module",
  "description": "Svelte components for Romanian form inputs",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "dev": "svelte-package -o dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "dependencies": {
    "@carpat/core": "workspace:*"
  },
  "devDependencies": {
