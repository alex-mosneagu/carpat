{
  "name": "@carpat/core",
  "version": "0.1.1",
  "type": "module",
  "description": "Framework-agnostic Romanian validators, formatters and data",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-mosneagu/carpat.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/alex-mosneagu/carpat/issues"
  },
  "homepage": "https://alex-mosneagu.github.io/carpat/",
  "keywords": [
    "romania",
    "cnp",
    "cui",
    "iban",
    "validation",
    "typescript"
  ],
  "sideEffects": false
}
