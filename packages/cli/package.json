{
  "name": "@carpat/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "CLI for Romanian validators (CNP, CUI, IBAN, phone, ID card, and more)",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "bin": {
    "carpat": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@carpat/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "romania",
    "cli",
    "cnp",
    "cui",
    "iban",
    "validators"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-mosneagu/carpat.git",
    "directory": "packages/cli"
  },
  "homepage": "https://alex-mosneagu.github.io/carpat/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/alex-mosneagu/carpat/issues"
  }
}
