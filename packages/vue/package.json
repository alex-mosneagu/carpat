{
  "name": "@carpat/vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 components for Romanian form inputs",
  "author": "Alex Mosneagu",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
