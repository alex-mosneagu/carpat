  },
  "dependencies": {
    "@carpat/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5",
    "vue": "^3.3.11"
  }
}
